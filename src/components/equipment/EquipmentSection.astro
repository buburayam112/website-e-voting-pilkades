---
import SectionHeader from '../common/SectionHeader.astro';
import DeviceImage from './DeviceImage.astro';
import { equipmentData } from '../../data/content/equipment.data';
---

<section id="perangkat" class="py-16 sm:py-20 lg:py-24 bg-slate-50/70 border-b border-slate-200/80">
  <div class="container-custom">
    
    <!-- Header -->
    <SectionHeader
      badge="Spesifikasi Perangkat"
      title="Pengenalan Perangkat E-Voting Resmi"
      subtitle="7 komponen perangkat keras bersertifikasi yang digunakan di setiap Tempat Pemungutan Suara (TPS)"
    />

    <!-- Device Cards Grid (SSR Fallback + Runtime Hydration) -->
    <div id="equipment-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {equipmentData.map((item, idx) => (
        <div
          class={`card-surface p-5 flex flex-col justify-between hover:shadow-elevated hover:border-primary-300 transition-all duration-200 group ${idx === 4 ? 'md:col-span-2 lg:col-span-2 xl:col-span-2' : ''}`}
          data-equipment-slug={item.id}
        >
          <div>
            <!-- Device Photo -->
            <div class="mb-4 rounded-xl overflow-hidden group-hover:scale-[1.02] transition-transform duration-200">
              <DeviceImage
                fotoUrl={item.fotoUrl}
                alt={item.nama}
                hasEmbeddedLabel={item.hasEmbeddedLabel}
              />
            </div>

            <!-- Category & Badge -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-primary px-2.5 py-0.5 rounded-md bg-primary-50 border border-primary-100">
                {item.kategori}
              </span>
              <span class="text-xs font-semibold text-slate-400">
                Unit 0{idx + 1}
              </span>
            </div>

            <!-- Name: tampilkan selalu, gambar yang punya label sudah clear -->
            <h3
              class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-primary transition-colors leading-snug"
              data-equipment-name
            >
              {item.nama}
            </h3>
            {item.alias && !item.hasEmbeddedLabel && (
              <p class="text-xs text-slate-500 font-mono mt-0.5">
                {item.alias}
              </p>
            )}

            <!-- Function -->
            <div class="mt-3 p-3 rounded-lg bg-slate-50 border border-slate-100">
              <span class="text-xs font-bold text-slate-700 block mb-0.5">Fungsi Utama:</span>
              <p class="text-xs text-slate-600 leading-relaxed" data-equipment-fungsi>
                {item.fungsi}
              </p>
            </div>

            <!-- Short description: sembunyikan jika gambar sudah mengandung deskripsi tertanam -->
            {!item.hasEmbeddedLabel && (
              <p class="mt-3 text-xs text-slate-600 leading-relaxed">
                {item.deskripsi}
              </p>
            )}
          </div>

          <!-- Bottom Spec Tag -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] text-slate-500">
            <svg class="w-3.5 h-3.5 text-accent flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span class="truncate" data-equipment-spec>{item.spesifikasi}</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Power & Backup Note -->
    <div class="mt-10 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-50/80 to-slate-50 border border-blue-200/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900">Perlengkapan Daya Cadangan (Genset &amp; UPS)</h4>
          <p class="text-xs text-slate-600 mt-0.5">
            Sesuai SOP Pilkades 2026, setiap TPS diwajibkan menyiagakan Genset dan UPS mandiri untuk memastikan pemungutan suara tidak terhenti jika suplai listrik PLN terganggu.
          </p>
        </div>
      </div>
      <a href="#keamanan" class="btn-secondary text-xs py-2 px-3.5 whitespace-nowrap">
        Prosedur Kendala Teknis &rarr;
      </a>
    </div>

  </div>
</section>

<script>
  import { getActivePeralatan } from '../../services/peralatan.service';

  async function syncEquipmentFromSupabase() {
    try {
      const items = await getActivePeralatan();
      if (!items || items.length === 0) return;

      const map = new Map(items.map((row) => [row.slug, row]));

      document.querySelectorAll<HTMLElement>('[data-equipment-slug]').forEach((card) => {
        const slug = card.dataset.equipmentSlug;
        if (!slug) return;
        const row = map.get(slug);
        if (!row) return;

        // Render string secara aman via textContent (No raw HTML)
        const nameEl = card.querySelector('[data-equipment-name]');
        if (nameEl && row.nama) nameEl.textContent = row.nama;

        const fungsiEl = card.querySelector('[data-equipment-fungsi]');
        if (fungsiEl && row.fungsi) fungsiEl.textContent = row.fungsi;

        const specEl = card.querySelector('[data-equipment-spec]');
        if (specEl) {
          const specObj = row.spesifikasi as any;
          if (specObj?.keterangan) {
            specEl.textContent = String(specObj.keterangan);
          } else if (typeof row.spesifikasi === 'string') {
            specEl.textContent = row.spesifikasi;
          }
        }
      });
    } catch {
      // Fallback silently: konten statis bawaan tetap ditampilkan sempurna
    }
  }

  syncEquipmentFromSupabase();
</script>

