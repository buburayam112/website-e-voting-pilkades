---
import KominfoLogo from '../common/KominfoLogo.astro';
import { siteConfig } from '../../config/site';

const navItems = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Tentang', href: '#tentang' },
  { label: 'Dasar Hukum', href: '#dasar-hukum' },
  { label: 'Perangkat', href: '#perangkat' },
  { label: 'Tahapan', href: '#tahapan' },
  { label: 'Keamanan', href: '#keamanan' },
  { label: 'Calon Kades', href: '#calon' },
  { label: 'Statistik', href: '#statistik' },
  { label: 'Kontak', href: '#kontak' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs transition-all duration-300" id="main-header">
  <div class="container-custom">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo -->
      <a href="#beranda" class="group flex items-center focus:outline-none focus:ring-2 focus:ring-primary rounded-lg p-1">
        <KominfoLogo />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center space-x-1" aria-label="Navigasi Utama">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-primary hover:bg-slate-50 rounded-lg transition-colors duration-150"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="#cek-hak-pilih"
          class="btn-primary text-sm shadow-md hover:shadow-lg transition-all"
        >
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>Cek Hak Pilih</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex xl:hidden items-center gap-2">
        <a
          href="#cek-hak-pilih"
          class="hidden sm:inline-flex md:hidden btn-primary text-xs py-2 px-3"
        >
          Cek Hak Pilih
        </a>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center p-2 rounded-lg text-slate-600 hover:text-primary hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-primary"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Buka Menu Navigasi"
        >
          <!-- Hamburger Icon -->
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon -->
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="xl:hidden hidden border-t border-slate-200 bg-white/98 backdrop-blur-lg px-4 pt-3 pb-6 shadow-xl transition-all"
    aria-label="Navigasi Mobile"
  >
    <div class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700 hover:text-primary hover:bg-slate-50 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col gap-2">
      <a
        href="#cek-hak-pilih"
        class="mobile-nav-link btn-primary w-full text-center justify-center text-sm"
      >
        <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span>Cek Hak Pilih Sekarang</span>
      </a>
      <a
        href={siteConfig.backOfficeDomain}
        target="_blank"
        rel="noopener noreferrer"
        class="text-center text-xs text-slate-500 hover:text-primary py-1.5 transition-colors"
      >
        Akses Back-Office Internal Diskominfo &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Interaction
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close menu when a link is clicked
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>

