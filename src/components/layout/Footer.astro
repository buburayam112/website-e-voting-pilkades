---
import KominfoLogo from '../common/KominfoLogo.astro';
import { siteConfig } from '../../config/site';
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800" id="kontak">
  <div class="container-custom py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Identity & Intro -->
      <div class="lg:col-span-1 space-y-4">
        <div class="bg-white/10 p-3 rounded-xl inline-block">
          <KominfoLogo className="h-10 text-white" showText={false} />
        </div>
        <div>
          <h3 class="text-white font-bold text-lg tracking-tight">EVOTE MEMPAWAH</h3>
          <p class="text-xs text-accent mt-0.5 font-medium">Pemerintah Kabupaten Mempawah</p>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Portal informasi publik resmi pelaksanaan Pemilihan Kepala Desa berbasis Sistem Pemungutan Suara Elektronik (E-Voting) Tahun 2026.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary-900/80 text-accent border border-primary-700">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            Front-Office Layanan Publik
          </span>
        </div>
      </div>

      <!-- Column 2: Tiga Pilar Tim Teknis -->
      <div class="space-y-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider">Tim Teknis Penyelenggara</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
            <div>
              <p class="font-medium text-slate-200">Diskominfo Kab. Mempawah</p>
              <p class="text-xs text-slate-400">Tim Teknis Inti (Sistem, Jaringan & Keamanan)</p>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
            <div>
              <p class="font-medium text-slate-200">Dukcapil Kab. Mempawah</p>
              <p class="text-xs text-slate-400">Tim Teknis DPT (Verifikasi Data Kependudukan)</p>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
            <div>
              <p class="font-medium text-slate-200">Dinas PMD Kab. Mempawah</p>
              <p class="text-xs text-slate-400">Tim Teknis Lapangan (Pemberdayaan Desa & PPKD)</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 3: Tautan Terkait & Back-Office -->
      <div class="space-y-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider">Tautan Resmi</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#beranda" class="hover:text-accent transition-colors flex items-center gap-2">
              <span class="text-xs">&rarr;</span> Beranda & Alur Pemilihan
            </a>
          </li>
          <li>
            <a href="#cek-hak-pilih" class="hover:text-accent transition-colors flex items-center gap-2">
              <span class="text-xs">&rarr;</span> Cek Hak Pilih Mandiri
            </a>
          </li>
          <li>
            <a href="#perangkat" class="hover:text-accent transition-colors flex items-center gap-2">
              <span class="text-xs">&rarr;</span> Spesifikasi Perangkat E-Voting
            </a>
          </li>
          <li>
            <a href="#keamanan" class="hover:text-accent transition-colors flex items-center gap-2">
              <span class="text-xs">&rarr;</span> Keamanan & VVPAT Audit
            </a>
          </li>
          <li>
            <a href="#dasar-hukum" class="hover:text-accent transition-colors flex items-center gap-2">
              <span class="text-xs">&rarr;</span> Perbup No. 28 Tahun 2026
            </a>
          </li>
          <li class="pt-2">
            <a
              href={siteConfig.backOfficeDomain}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 text-xs font-medium text-blue-300 hover:bg-slate-700 hover:text-white border border-slate-700 transition-colors"
            >
              <span>Portal Back-Office PPKD</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Kontak & Pusat Informasi -->
      <div class="space-y-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider">Kontak & Posko Informasi</h4>
        <div class="space-y-2.5 text-xs text-slate-400">
          <div>
            <span class="text-slate-300 font-medium block">Alamat Sekretariat:</span>
            <p class="mt-0.5">{siteConfig.kontak.alamat}</p>
          </div>
          <div>
            <span class="text-slate-300 font-medium block">Posko Informasi & Helpdesk:</span>
            <p class="mt-0.5 text-accent font-semibold">{siteConfig.kontak.callCenterPilkades}</p>
          </div>
          <div>
            <span class="text-slate-300 font-medium block">Telepon Kantor Diskominfo:</span>
            <p class="mt-0.5">{siteConfig.kontak.telepon}</p>
          </div>
          <div>
            <span class="text-slate-300 font-medium block">Surat Elektronik (Email):</span>
            <p class="mt-0.5">{siteConfig.kontak.email}</p>
          </div>
          <div>
            <span class="text-slate-300 font-medium block">Jam Layanan Konsultasi:</span>
            <p class="mt-0.5">{siteConfig.kontak.jamLayanan}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; 2026 Pemerintah Kabupaten Mempawah — Dinas Komunikasi dan Informatika. Seluruh hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-6">
        <a href="#keamanan" class="hover:text-slate-400 transition-colors">Kebijakan Privasi & Perlindungan Data</a>
        <a href="#dasar-hukum" class="hover:text-slate-400 transition-colors">Dasar Hukum</a>
        <a href="#kontak" class="hover:text-slate-400 transition-colors">Bantuan Warga</a>
      </div>
    </div>
  </div>
</footer>

