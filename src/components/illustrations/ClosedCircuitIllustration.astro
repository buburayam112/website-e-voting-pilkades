---
interface Props {
  className?: string;
}

const { className = "w-full max-w-2xl mx-auto h-auto" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 600 440"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Diagram Rantai Keamanan E-Voting: Sirkuit Tertutup"
>
  <defs>
    <linearGradient id="secCobalt" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1B51A3" />
      <stop offset="100%" stop-color="#103369" />
    </linearGradient>
    <filter id="shadowCirc" x="-10%" y="-10%" width="120%" height="125%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1B51A3" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Circular Loop Track -->
  <circle cx="300" cy="220" r="145" stroke="#CBD7EC" stroke-width="6" stroke-dasharray="10 8" />
  
  <!-- Directional Loop Arrows -->
  <path d="M 300 75 A 145 145 0 0 1 445 220" stroke="#3FC6F3" stroke-width="4" stroke-linecap="round" />
  <path d="M 445 220 A 145 145 0 0 1 300 365" stroke="#1B51A3" stroke-width="4" stroke-linecap="round" />
  <path d="M 300 365 A 145 145 0 0 1 155 220" stroke="#5172AE" stroke-width="4" stroke-linecap="round" />
  <path d="M 155 220 A 145 145 0 0 1 300 75" stroke="#3FC6F3" stroke-width="4" stroke-linecap="round" />

  <!-- Center Hub: Sirkuit Tertutup Offline Shield -->
  <g filter="url(#shadowCirc)">
    <rect x="220" y="155" width="160" height="130" rx="16" fill="url(#secCobalt)" stroke="#3FC6F3" stroke-width="2.5" />
    <!-- Shield Icon -->
    <path d="M300 175 L320 185 C320 205 310 215 300 220 C290 215 280 205 280 185 Z" fill="#3FC6F3" />
    <path d="M295 198 L298 201 L306 193" stroke="#0C264D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <text x="300" y="240" font-family="sans-serif" font-size="11" font-weight="bold" fill="#FFFFFF" text-anchor="middle">JARINGAN LOKAL</text>
    <text x="300" y="254" font-family="sans-serif" font-size="9" fill="#3FC6F3" text-anchor="middle">100% AIR-GAPPED</text>
    <text x="300" y="268" font-family="sans-serif" font-size="8" fill="#DEF6FD" text-anchor="middle">Kebal Peretasan Internet</text>
  </g>

  <!-- Node 1: Top Left - Identitas Digital (e-KTP & DPT) -->
  <g filter="url(#shadowCirc)" transform="translate(60, 45)">
    <rect x="0" y="0" width="180" height="75" rx="10" fill="#FFFFFF" stroke="#C2D7F3" stroke-width="1.5" />
    <rect x="10" y="12" width="28" height="20" rx="3" fill="#2568CF" />
    <circle cx="18" cy="20" r="3" fill="#FFFFFF" />
    <rect x="10" y="38" width="28" height="4" rx="2" fill="#3FC6F3" />
    <text x="46" y="24" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1B51A3">1. Identitas Digital</text>
    <text x="46" y="38" font-family="sans-serif" font-size="7.5" fill="#64748B">e-KTP diverifikasi melalui</text>
    <text x="46" y="49" font-family="sans-serif" font-size="7.5" fill="#64748B">DPT elektronik terkunci.</text>
    <rect x="46" y="55" width="55" height="12" rx="3" fill="#DEF6FD" />
    <text x="50" y="64" font-family="sans-serif" font-size="6.5" font-weight="bold" fill="#1B51A3">Cegah Ganda</text>
  </g>

  <!-- Node 2: Top Right - Kunci Fisik Anonim (Smartcard) -->
  <g filter="url(#shadowCirc)" transform="translate(360, 45)">
    <rect x="0" y="0" width="180" height="75" rx="10" fill="#FFFFFF" stroke="#C2D7F3" stroke-width="1.5" />
    <rect x="10" y="12" width="28" height="20" rx="3" fill="#1B51A3" />
    <rect x="14" y="16" width="7" height="6" fill="#FBBF24" />
    <circle cx="28" cy="22" r="3" fill="#3FC6F3" />
    <text x="46" y="24" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1B51A3">2. Kunci Fisik Anonim</text>
    <text x="46" y="38" font-family="sans-serif" font-size="7.5" fill="#64748B">Ditukar Smartcard token</text>
    <text x="46" y="49" font-family="sans-serif" font-size="7.5" fill="#64748B">acak sekali pakai.</text>
    <rect x="46" y="55" width="62" height="12" rx="3" fill="#FEF3C7" />
    <text x="50" y="64" font-family="sans-serif" font-size="6.5" font-weight="bold" fill="#92400E">Tanpa Data Pribadi</text>
  </g>

  <!-- Node 3: Bottom Right - Pilihan Digital Terenkripsi -->
  <g filter="url(#shadowCirc)" transform="translate(360, 310)">
    <rect x="0" y="0" width="180" height="75" rx="10" fill="#FFFFFF" stroke="#C2D7F3" stroke-width="1.5" />
    <rect x="10" y="12" width="28" height="22" rx="3" fill="#0C264D" />
    <circle cx="24" cy="23" r="5" stroke="#3FC6F3" stroke-width="1.5" />
    <text x="46" y="24" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1B51A3">3. Pilihan Digital</text>
    <text x="46" y="38" font-family="sans-serif" font-size="7.5" fill="#64748B">Enkripsi lokal di mesin</text>
    <text x="46" y="49" font-family="sans-serif" font-size="7.5" fill="#64748B">tanpa internet publik.</text>
    <rect x="46" y="55" width="55" height="12" rx="3" fill="#DCFCE7" />
    <text x="50" y="64" font-family="sans-serif" font-size="6.5" font-weight="bold" fill="#166534">Enkripsi Kuat</text>
  </g>

  <!-- Node 4: Bottom Left - Lembar Struk & Kotak Suara/Audit -->
  <g filter="url(#shadowCirc)" transform="translate(60, 310)">
    <rect x="0" y="0" width="180" height="75" rx="10" fill="#FFFFFF" stroke="#C2D7F3" stroke-width="1.5" />
    <rect x="10" y="12" width="24" height="22" rx="2" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1" />
    <line x1="14" y1="18" x2="28" y2="18" stroke="#1B51A3" stroke-width="1.5" />
    <line x1="14" y1="23" x2="26" y2="23" stroke="#64748B" stroke-width="1" />
    <line x1="14" y1="27" x2="28" y2="27" stroke="#64748B" stroke-width="1" />
    <text x="46" y="24" font-family="sans-serif" font-size="10" font-weight="bold" fill="#1B51A3">4. Lembar Struk Audit</text>
    <text x="46" y="38" font-family="sans-serif" font-size="7.5" fill="#64748B">Lembar struk dicetak & masuk</text>
    <text x="46" y="49" font-family="sans-serif" font-size="7.5" fill="#64748B">ke kotak suara/audit (Ps. 46).</text>
    <rect x="46" y="55" width="60" height="12" rx="3" fill="#DCFCE7" />
    <text x="50" y="64" font-family="sans-serif" font-size="6.5" font-weight="bold" fill="#166534">Bukti Sah Fisik</text>
  </g>
</svg>

