---
interface Props {
  stepNumber: number;
  className?: string;
}

const { stepNumber, className = "w-full h-48" } = Astro.props;
---

<div class={`flex items-center justify-center p-4 bg-gradient-to-br from-slate-50 to-blue-50/40 rounded-xl overflow-hidden ${className}`}>
  {stepNumber === 1 && (
    <svg viewBox="0 0 240 160" class="w-full h-full max-h-44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Meja 1 KPPS -->
      <path d="M40 105 L200 105 L180 135 L60 135 Z" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="2" />
      <rect x="70" y="115" width="100" height="15" rx="3" fill="#1B51A3" />
      <text x="78" y="125" font-family="sans-serif" font-size="7" font-weight="bold" fill="#FFFFFF">MEJA 1: VERIFIKASI IDENTITAS</text>
      <!-- KPPS Officer Left -->
      <circle cx="85" cy="55" r="14" fill="#5172AE" />
      <path d="M65 95 C65 78 72 75 85 75 C98 75 105 78 105 95 Z" fill="#1B51A3" />
      <!-- Laptop on Table -->
      <rect x="75" y="80" width="30" height="22" rx="2" fill="#1E293B" />
      <rect x="77" y="82" width="26" height="15" fill="#3FC6F3" fill-opacity="0.8" />
      <!-- KTP Reader / Scanner -->
      <rect x="112" y="88" width="16" height="12" rx="2" fill="#334155" />
      <circle cx="120" cy="94" r="3" fill="#10B981" />
      <!-- Voter Right -->
      <circle cx="165" cy="55" r="14" fill="#64748B" />
      <path d="M145 95 C145 78 152 75 165 75 C178 75 185 78 185 95 Z" fill="#475569" />
      <!-- e-KTP being handed over -->
      <rect x="125" y="70" width="22" height="14" rx="2" fill="#2568CF" stroke="#93C5FD" stroke-width="1.5" />
      <rect x="127" y="72" width="5" height="6" fill="#FBBF24" />
      <!-- Badge "Cek DPT" -->
      <rect x="90" y="25" width="60" height="18" rx="9" fill="#10B981" />
      <text x="100" y="37" font-family="sans-serif" font-size="8" font-weight="bold" fill="#FFFFFF">✓ DPT Terkunci</text>
    </svg>
  )}

  {stepNumber === 2 && (
    <svg viewBox="0 0 240 160" class="w-full h-full max-h-44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Desk -->
      <rect x="50" y="95" width="140" height="30" rx="4" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="2" />
      <!-- Officer Handing Card -->
      <circle cx="70" cy="55" r="14" fill="#5172AE" />
      <path d="M50 95 C50 78 58 75 70 75 C82 75 90 78 90 95 Z" fill="#1B51A3" />
      <!-- Voter Receiving Card -->
      <circle cx="170" cy="55" r="14" fill="#64748B" />
      <path d="M150 95 C150 78 158 75 170 75 C182 75 190 78 190 95 Z" fill="#475569" />
      <!-- Smartcard Token in Transition with Glow -->
      <g transform="translate(100, 60)">
        <rect x="0" y="0" width="40" height="26" rx="4" fill="#1B51A3" stroke="#3FC6F3" stroke-width="2" />
        <rect x="6" y="6" width="10" height="8" rx="1.5" fill="#FBBF24" />
        <circle cx="28" cy="13" r="5" fill="#3FC6F3" />
      </g>
      <!-- Key Concept Callout Badge -->
      <rect x="55" y="15" width="130" height="24" rx="12" fill="#FFFFFF" stroke="#3FC6F3" stroke-width="1.5" />
      <text x="70" y="31" font-family="sans-serif" font-size="8.5" font-weight="bold" fill="#1B51A3">Token Anonim Sekali Pakai</text>
    </svg>
  )}

  {stepNumber === 3 && (
    <svg viewBox="0 0 240 160" class="w-full h-full max-h-44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Bilik Suara Partisi -->
      <path d="M35 130 L35 35 L125 15 L125 130 Z" fill="#CBD5E1" stroke="#94A3B8" stroke-width="2" />
      <path d="M125 15 L165 30 L165 130 L125 130 Z" fill="#E2E8F0" stroke="#94A3B8" stroke-width="2" />
      <!-- Touchscreen Monitor inside Bilik -->
      <rect x="55" y="45" width="55" height="42" rx="4" fill="#0C264D" stroke="#3FC6F3" stroke-width="2" />
      <circle cx="70" cy="62" r="5" fill="#FFFFFF" />
      <circle cx="92" cy="62" r="5" fill="#3FC6F3" />
      <!-- Confirmation Buttons in Screen -->
      <rect x="60" y="73" width="18" height="8" rx="2" fill="#10B981" />
      <text x="64" y="79" font-family="sans-serif" font-size="5" font-weight="bold" fill="#FFFFFF">YA</text>
      <rect x="82" y="73" width="18" height="8" rx="2" fill="#EF4444" />
      <text x="84" y="79" font-family="sans-serif" font-size="5" font-weight="bold" fill="#FFFFFF">TIDAK</text>
      <!-- Voter inside Bilik with hand touching screen -->
      <circle cx="85" cy="100" r="12" fill="#64748B" />
      <path d="M70 135 C70 120 75 116 85 116 C95 116 100 120 100 135 Z" fill="#475569" />
      <line x1="88" y1="108" x2="84" y2="76" stroke="#475569" stroke-width="3" stroke-linecap="round" />
      <!-- Callout "Cukup 2 Kali Sentuh" -->
      <rect x="135" y="55" width="95" height="35" rx="8" fill="#FFFFFF" stroke="#1B51A3" stroke-width="1.5" />
      <text x="145" y="70" font-family="sans-serif" font-size="8" font-weight="bold" fill="#1B51A3">Cukup 2x Sentuh</text>
      <text x="145" y="82" font-family="sans-serif" font-size="7" fill="#5172AE">Pilih Calon & Konfirmasi</text>
    </svg>
  )}

  {stepNumber === 4 && (
    <svg viewBox="0 0 240 160" class="w-full h-full max-h-44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Printer unit on side table facing forward -->
      <rect x="30" y="65" width="45" height="38" rx="4" fill="#1E293B" />
      <!-- Thermal paper emerging -->
      <path d="M42 65 L42 45 L62 45 L62 65 Z" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.5" />
      <line x1="46" y1="52" x2="58" y2="52" stroke="#1B51A3" stroke-width="1.5" />
      <!-- Voter inserting paper into ballot audit box -->
      <circle cx="120" cy="50" r="14" fill="#64748B" />
      <path d="M100 90 C100 75 108 70 120 70 C132 70 140 75 140 90 Z" fill="#475569" />
      <!-- Kotak Audit Fisik Transparan & Terkunci -->
      <path d="M140 95 L190 95 L180 140 L130 140 Z" fill="#E2E8F0" stroke="#5172AE" stroke-width="2" />
      <path d="M140 95 L165 78 L215 78 L190 95 Z" fill="#F1F5F9" stroke="#5172AE" stroke-width="2" />
      <path d="M190 95 L215 78 L205 123 L180 140 Z" fill="#CBD5E1" stroke="#5172AE" stroke-width="2" />
      <!-- Slot on Top & Padlock -->
      <line x1="160" y1="87" x2="190" y2="87" stroke="#0F172A" stroke-width="2" />
      <rect x="155" y="105" width="14" height="12" rx="2" fill="#FBBF24" />
      <circle cx="162" cy="102" r="4" stroke="#B45309" stroke-width="1.5" />
      <!-- Paper slip entering slot -->
      <path d="M168 76 L168 94 L178 94 L178 76 Z" fill="#FFFFFF" stroke="#94A3B8" stroke-width="1" />
      <!-- Callout "Struk Sah" -->
      <rect x="50" y="12" width="140" height="22" rx="11" fill="#10B981" />
      <text x="65" y="26" font-family="sans-serif" font-size="8" font-weight="bold" fill="#FFFFFF">Struk Kertas = Bukti Sah Final</text>
    </svg>
  )}

  {stepNumber === 5 && (
    <svg viewBox="0 0 240 160" class="w-full h-full max-h-44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Meja Tinta Exit -->
      <rect x="50" y="100" width="80" height="30" rx="3" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="2" />
      <!-- Ink Bottle -->
      <rect x="75" y="85" width="16" height="18" rx="2" fill="#1E1B4B" />
      <rect x="79" y="80" width="8" height="6" rx="1" fill="#312E81" />
      <!-- Voter Hand Dipping Finger -->
      <circle cx="95" cy="50" r="14" fill="#64748B" />
      <path d="M80 85 C80 72 87 68 95 68 C103 68 110 72 110 85 Z" fill="#475569" />
      <path d="M82 86 L82 89" stroke="#312E81" stroke-width="3" stroke-linecap="round" />
      <!-- One Way Exit Door Right -->
      <rect x="170" y="35" width="45" height="95" rx="3" fill="#1B51A3" />
      <rect x="175" y="42" width="35" height="18" rx="2" fill="#10B981" />
      <text x="181" y="54" font-family="sans-serif" font-size="7" font-weight="bold" fill="#FFFFFF">PINTU KELUAR</text>
      <!-- Exit Arrow -->
      <path d="M140 75 L160 75 M154 69 L160 75 L154 81" stroke="#10B981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <!-- No Turnaround sign -->
      <circle cx="145" cy="115" r="12" fill="#FEE2E2" stroke="#EF4444" stroke-width="1.5" />
      <path d="M140 115 L150 115" stroke="#EF4444" stroke-width="2" stroke-linecap="round" />
      <text x="60" y="24" font-family="sans-serif" font-size="8.5" font-weight="bold" fill="#1B51A3">Tanda Tinta & Jalur Satu Arah</text>
    </svg>
  )}
</div>

