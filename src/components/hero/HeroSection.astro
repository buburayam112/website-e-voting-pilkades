---
import HeroIllustration from '../illustrations/HeroIllustration.astro';
import { siteConfig } from '../../config/site';
---

<section id="beranda" class="relative overflow-hidden pt-8 pb-16 lg:py-24 bg-gradient-to-b from-blue-50/70 via-white to-background">
  <!-- Decorative background shapes -->
  <div class="absolute top-0 right-0 -mr-24 -mt-24 w-96 h-96 rounded-full bg-accent/10 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-24 -mb-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>

  <div class="container-custom relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Official Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-primary-200 shadow-xs text-xs font-semibold text-primary">
          <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
          <span>Portal Resmi Informasi Pilkades Kabupaten Mempawah 2026</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-black text-slate-900 tracking-tight leading-[1.15]">
          Pemilihan Kepala Desa <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-accent">
            Berbasis Elektronik
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Kenali proses, pahami tahapan, dan dapatkan informasi resmi E-Voting Pilkades Kabupaten Mempawah Tahun 2026.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="#cek-hak-pilih"
            class="btn-primary w-full sm:w-auto px-7 py-3.5 text-base shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 group"
          >
            <svg class="w-5 h-5 text-accent group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span>Cek Hak Pilih Mandiri</span>
          </a>

          <a
            href="#tahapan"
            class="btn-secondary w-full sm:w-auto px-6 py-3.5 text-base border-slate-300 hover:border-primary-300"
          >
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Pelajari Cara Memilih</span>
          </a>
        </div>

        <!-- Three Foundation Highlights -->
        <div class="pt-6 border-t border-slate-200/80 grid grid-cols-3 gap-3 sm:gap-6 text-center">
          <div class="bg-white/80 backdrop-blur-xs p-3 rounded-xl border border-slate-200/60 shadow-xs">
            <span class="text-xs sm:text-sm font-bold text-primary block">CEPAT</span>
            <span class="text-[11px] sm:text-xs text-slate-500">Digitalisasi Efisien</span>
          </div>
          <div class="bg-white/80 backdrop-blur-xs p-3 rounded-xl border border-slate-200/60 shadow-xs">
            <span class="text-xs sm:text-sm font-bold text-secondary block">AMAN</span>
            <span class="text-[11px] sm:text-xs text-slate-500">Sirkuit Tertutup Offline</span>
          </div>
          <div class="bg-white/80 backdrop-blur-xs p-3 rounded-xl border border-slate-200/60 shadow-xs">
            <span class="text-xs sm:text-sm font-bold text-accent-700 block">TRANSPARAN</span>
            <span class="text-[11px] sm:text-xs text-slate-500">Struk Audit Fisik VVPAT</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Digital Illustration -->
      <div class="lg:col-span-5 flex justify-center items-center">
        <div class="relative w-full max-w-lg">
          <div class="absolute -inset-4 bg-gradient-to-r from-accent/20 to-primary/10 rounded-3xl blur-xl transform -rotate-1"></div>
          <div class="relative bg-white/60 backdrop-blur-md rounded-2xl p-4 sm:p-6 border border-white/80 shadow-elevated">
            <HeroIllustration />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

