---
interface Props {
  badge?: string;
  badgeVariant?: 'primary' | 'accent' | 'simulation' | 'official';
  title: string;
  subtitle?: string;
  center?: boolean;
}

const {
  badge,
  badgeVariant = 'primary',
  title,
  subtitle,
  center = true
} = Astro.props;

const badgeClasses = {
  primary: 'bg-primary-50 text-primary-700 border-primary-200',
  accent: 'bg-accent-50 text-accent-800 border-accent-200',
  simulation: 'bg-amber-100 text-amber-900 border-amber-300 font-semibold',
  official: 'bg-emerald-100 text-emerald-900 border-emerald-300'
};
---

<div class={`mb-10 sm:mb-12 ${center ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'}`}>
  {badge && (
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3 border shadow-xs" class:list={[badgeClasses[badgeVariant]]}>
      <span>{badge}</span>
    </div>
  )}
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>

