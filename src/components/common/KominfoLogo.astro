---
interface Props {
  className?: string;
  showText?: boolean;
}

const { className = "h-11 sm:h-12 w-auto", showText = true } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 sm:gap-3 flex-shrink-0 ${className}`}>
  <!-- Logo Resmi Kabupaten Mempawah -->
  <img
    src="/images/logo-kabupaten-mempawah.png"
    alt="Lambang Kabupaten Mempawah"
    class="h-10 sm:h-11 w-auto max-h-12 object-contain flex-shrink-0 drop-shadow-xs transition-transform duration-200 group-hover:scale-105"
    loading="eager"
  />

  {showText && (
    <div class="flex flex-col justify-center text-left flex-shrink-0">
      <span class="text-[9.5px] sm:text-[10px] font-semibold tracking-wider text-slate-500 uppercase leading-none mb-0.5 whitespace-nowrap">
        Pemerintah Kab. Mempawah
      </span>
      <span class="text-sm sm:text-[15px] font-extrabold tracking-tight text-primary leading-tight whitespace-nowrap">
        E-Voting Pilkades 2026
      </span>
    </div>
  )}
</div>
