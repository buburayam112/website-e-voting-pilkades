---
interface Props {
  className?: string;
  showText?: boolean;
}

const { className = "h-12 sm:h-14 w-auto", showText = true } = Astro.props;
---

<div class={`inline-flex items-center gap-3 sm:gap-3.5 ${className}`}>
  <!-- Logo Resmi Kabupaten Mempawah (Diperbesar Proporsional) -->
  <img
    src="/images/logo-kabupaten-mempawah.png"
    alt="Lambang Kabupaten Mempawah"
    class="h-12 sm:h-14 w-auto max-h-14 object-contain flex-shrink-0 drop-shadow-xs transition-transform duration-200 group-hover:scale-105"
    loading="eager"
  />

  {showText && (
    <div class="flex flex-col justify-center">
      <span class="text-[10px] sm:text-[11px] font-semibold tracking-wider text-slate-500 uppercase leading-none mb-0.5">
        Pemerintah Kabupaten Mempawah
      </span>
      <span class="text-sm sm:text-base font-extrabold tracking-tight text-primary leading-tight whitespace-nowrap">
        E-Voting Kabupaten Mempawah
      </span>
    </div>
  )}
</div>

