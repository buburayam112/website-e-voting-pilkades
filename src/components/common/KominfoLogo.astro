---
interface Props {
  className?: string;
  showText?: boolean;
}

const { className = "h-10 w-auto", showText = true } = Astro.props;
---

<div class={`inline-flex items-center gap-3 ${className}`}>
  <!-- Kominfo Wave Symbol SVG recreated from Color Guide -->
  <svg
    class="h-10 w-10 flex-shrink-0"
    viewBox="0 0 120 120"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Logo Kominfo"
  >
    <!-- Background Circle -->
    <circle cx="60" cy="60" r="56" fill="#F8FAFC" />
    
    <!-- Top Wave / Cobalt Blue -->
    <path
      d="M24 64 C24 40 40 22 62 20 C85 18 102 34 102 54 C102 68 92 78 82 80 C68 83 58 72 60 58 C62 48 72 44 80 48 C68 40 50 44 46 58 C42 70 54 82 68 82 C84 82 98 68 98 52 C98 32 80 18 58 22 C38 25 24 42 24 64 Z"
      fill="#1B51A3"
    />
    
    <!-- Middle Wave / Prussian Blue -->
    <path
      d="M32 72 C32 54 44 40 60 38 C76 36 90 48 90 62 C90 72 82 80 74 81 C64 82 56 74 58 64 C60 56 68 53 74 56 C64 50 50 54 48 64 C46 72 54 80 64 80 C76 80 84 70 84 60 C84 48 72 38 56 40 C42 42 32 54 32 72 Z"
      fill="#5172AE"
    />

    <!-- Inner Wave / Sea Blue Accent -->
    <path
      d="M44 76 C44 64 52 56 62 55 C72 54 80 62 80 70 C80 76 75 81 70 81 C63 81 58 76 60 70 C61 65 66 63 70 65 C64 62 55 64 54 70 C53 75 58 80 64 80 C71 80 76 74 76 68 C76 61 69 55 60 57 C51 59 44 66 44 76 Z"
      fill="#3FC6F3"
    />

    <!-- Center Swirl Core -->
    <circle cx="65" cy="72" r="4.5" fill="#1B51A3" />
  </svg>

  {showText && (
    <div class="flex flex-col">
      <span class="text-xs font-semibold tracking-wider text-slate-500 uppercase">Pemerintah Kabupaten Mempawah</span>
      <span class="text-base sm:text-lg font-bold tracking-tight text-primary leading-tight">EVOTE MEMPAWAH</span>
    </div>
  )}
</div>

