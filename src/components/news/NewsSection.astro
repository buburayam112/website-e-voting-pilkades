---
import SectionHeader from '../common/SectionHeader.astro';
import { initialBeritaMock } from '../../data/mock/berita.mock';
---

<section id="berita" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-slate-200/80 relative">
  <!-- Subtle background glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-primary-100/40 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <SectionHeader
      badge="Kabar & Sosialisasi Resmi"
      title="Pusat Informasi & Berita E-Voting"
      subtitle="Publikasi kabar terkini, panduan teknis TPS, regulasi, dan sosialisasi Pilkades Kabupaten Mempawah 2026"
    />

    <!-- Filter & Search Bar Warga -->
    <div class="max-w-5xl mx-auto mb-10 flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 scrollbar-none" id="news-category-filters">
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-primary text-white shadow-xs"
          data-category="all"
        >
          Semua Berita
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:text-primary hover:bg-slate-100 transition-all duration-200"
          data-category="Sosialisasi"
        >
          Sosialisasi
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:text-primary hover:bg-slate-100 transition-all duration-200"
          data-category="Teknis & Peralatan"
        >
          Teknis & Alat
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:text-primary hover:bg-slate-100 transition-all duration-200"
          data-category="Regulasi"
        >
          Regulasi
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:text-primary hover:bg-slate-100 transition-all duration-200"
          data-category="Jadwal & Tahapan"
        >
          Jadwal
        </button>
      </div>

      <!-- Search Box -->
      <div class="relative w-full md:w-72">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
        <input
          type="text"
          id="public-news-search"
          placeholder="Cari topik berita..."
          class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 transition-all"
        />
      </div>
    </div>

    <!-- News Grid Container (Rendered dynamically & hydrated from localStorage) -->
    <div
      id="news-cards-container"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto"
    >
      <!-- Fallback SSR items: will be hydrated on client with localStorage changes -->
      {initialBeritaMock.filter(b => b.status === 'published').map((berita) => (
        <article
          class="news-card card-surface overflow-hidden flex flex-col justify-between hover:shadow-elevated hover:border-primary-300 transition-all duration-300 group"
          data-category={berita.kategori}
          data-id={berita.id}
        >
          <div>
            <!-- Thumbnail Image -->
            <div class="relative h-48 w-full overflow-hidden bg-slate-100">
              <img
                src={berita.gambarUrl}
                alt={berita.judul}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='/images/logo-kabupaten-mempawah.png'; this.className='w-full h-full object-contain p-8 bg-slate-50';"
              />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/95 text-primary shadow-xs backdrop-blur-xs border border-white/40">
                {berita.kategori}
              </span>
            </div>

            <!-- Content Area -->
            <div class="p-5 sm:p-6">
              <!-- Meta: Tanggal & Penulis -->
              <div class="flex items-center gap-2 text-xs text-slate-500 mb-2.5">
                <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                  <line x1="16" x1="2" x2="16" y2="6"></line>
                  <line x1="8" x1="2" x2="8" y2="6"></line>
                  <line x1="3" x1="10" x2="21" y2="10"></line>
                </svg>
                <time datetime={berita.tanggalPublikasi}>{berita.tanggalPublikasi}</time>
                <span class="text-slate-300">•</span>
                <span class="truncate max-w-[140px]">{berita.penulis}</span>
              </div>

              <!-- Title -->
              <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-primary transition-colors leading-snug mb-2 line-clamp-2">
                {berita.judul}
              </h3>

              <!-- Excerpt -->
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
                {berita.ringkasan}
              </p>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-0">
            <button
              type="button"
              class="btn-read-news w-full inline-flex items-center justify-between text-xs sm:text-sm font-semibold text-primary group-hover:text-primary-600 py-2.5 px-3 rounded-xl bg-primary-50/70 hover:bg-primary-100 transition-colors"
              data-news-id={berita.id}
            >
              <span>Baca Selengkapnya</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State (Hidden by default) -->
    <div id="news-empty-state" class="hidden max-w-md mx-auto text-center py-12 px-4">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </div>
      <h4 class="text-base font-bold text-slate-800">Tidak ada berita ditemukan</h4>
      <p class="text-xs text-slate-500 mt-1">Coba gunakan kata kunci lain atau pilih kategori yang berbeda.</p>
    </div>

  </div>
</section>

<!-- ============================================================== -->
<!-- MODAL DETAIL BERITA RESMI UNTUK MASYARAKAT                     -->
<!-- ============================================================== -->
<div
  id="news-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-sm transition-opacity p-4 sm:p-6 md:p-10 flex items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-news-title"
>
  <div class="relative w-full max-w-3xl bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden max-h-[90vh] flex flex-col">
    <!-- Modal Header Image & Close Button -->
    <div class="relative h-56 sm:h-72 w-full bg-slate-100 flex-shrink-0">
      <img
        id="modal-news-img"
        src=""
        alt="Thumbnail Berita"
        class="w-full h-full object-cover"
        onerror="this.src='/images/logo-kabupaten-mempawah.png'; this.className='w-full h-full object-contain p-10 bg-slate-50';"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
      
      <!-- Close Button -->
      <button
        type="button"
        id="modal-news-close-btn"
        class="absolute top-4 right-4 p-2 rounded-full bg-white/80 hover:bg-white text-slate-700 hover:text-slate-900 backdrop-blur-sm shadow-md transition-all"
        title="Tutup Berita"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Category & Date Overlay -->
      <div class="absolute bottom-4 left-6 right-6">
        <div class="flex items-center gap-2 mb-2">
          <span
            id="modal-news-category"
            class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-accent text-[#0C264D]"
          >
            Kategori
          </span>
          <span
            id="modal-news-date"
            class="text-xs text-white/90 font-medium"
          >
            Tanggal
          </span>
        </div>
        <h2
          id="modal-news-title"
          class="text-lg sm:text-2xl font-bold text-white leading-tight drop-shadow-sm"
        >
          Judul Berita
        </h2>
      </div>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-6 sm:p-8 overflow-y-auto space-y-5 text-slate-700 leading-relaxed text-sm sm:text-base">
      <!-- Excerpt Highlight -->
      <div class="p-4 rounded-xl bg-blue-50/70 border-l-4 border-primary text-slate-800 font-medium text-xs sm:text-sm">
        <p id="modal-news-excerpt"></p>
      </div>

      <!-- Author info -->
      <div class="flex items-center justify-between text-xs text-slate-500 py-2 border-y border-slate-100">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <strong id="modal-news-author" class="text-slate-700">Penulis</strong>
        </span>
        <span class="flex items-center gap-1.5 text-emerald-700 font-medium">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Informasi Terverifikasi Kominfo
        </span>
      </div>

      <!-- Full Article Body -->
      <div id="modal-news-content" class="space-y-4 whitespace-pre-line text-slate-800 leading-relaxed font-sans">
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 sm:px-8 border-t border-slate-100 bg-slate-50/70 flex items-center justify-between flex-shrink-0">
      <div class="text-xs text-slate-500 flex items-center gap-1">
        <span>Portal Informasi Resmi E-Voting Kab. Mempawah</span>
      </div>
      <button
        type="button"
        id="modal-news-footer-close-btn"
        class="px-5 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold text-xs sm:text-sm transition-colors"
      >
        Tutup
      </button>
    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- CLIENT HYDRATION SCRIPT                                        -->
<!-- ============================================================== -->
<script>
  import { BeritaService } from '../../services/berita.service';
  import type { Berita } from '../../types';

  let currentCategory = 'all';
  let searchQuery = '';

  function renderNewsCards() {
    const container = document.getElementById('news-cards-container');
    const emptyState = document.getElementById('news-empty-state');
    if (!container || !emptyState) return;

    // Get published news filtered by active category and search query
    const newsList = BeritaService.getBeritaList({
      status: 'published',
      kategori: currentCategory,
      search: searchQuery
    });

    if (newsList.length === 0) {
      container.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');

    container.innerHTML = newsList.map((berita) => `
      <article
        class="news-card card-surface overflow-hidden flex flex-col justify-between hover:shadow-elevated hover:border-primary-300 transition-all duration-300 group"
        data-category="${escapeHtml(berita.kategori)}"
        data-id="${escapeHtml(berita.id)}"
      >
        <div>
          <!-- Thumbnail Image -->
          <div class="relative h-48 w-full overflow-hidden bg-slate-100">
            <img
              src="${escapeHtml(berita.gambarUrl)}"
              alt="${escapeHtml(berita.judul)}"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.src='/images/logo-kabupaten-mempawah.png'; this.className='w-full h-full object-contain p-8 bg-slate-50';"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/95 text-primary shadow-xs backdrop-blur-xs border border-white/40">
              ${escapeHtml(berita.kategori)}
            </span>
          </div>

          <!-- Content Area -->
          <div class="p-5 sm:p-6">
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-2.5">
              <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <time datetime="${escapeHtml(berita.tanggalPublikasi)}">${escapeHtml(berita.tanggalPublikasi)}</time>
              <span class="text-slate-300">•</span>
              <span class="truncate max-w-[140px]">${escapeHtml(berita.penulis)}</span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-primary transition-colors leading-snug mb-2 line-clamp-2">
              ${escapeHtml(berita.judul)}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
              ${escapeHtml(berita.ringkasan)}
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-0">
          <button
            type="button"
            class="btn-read-news w-full inline-flex items-center justify-between text-xs sm:text-sm font-semibold text-primary group-hover:text-primary-600 py-2.5 px-3 rounded-xl bg-primary-50/70 hover:bg-primary-100 transition-colors"
            data-news-id="${escapeHtml(berita.id)}"
          >
            <span>Baca Selengkapnya</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </article>
    `).join('');

    // Reattach click listeners for "Baca Selengkapnya"
    container.querySelectorAll('.btn-read-news').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (btn as HTMLElement).dataset.newsId;
        if (id) openNewsModal(id);
      });
    });
  }

  function openNewsModal(id: string) {
    const berita = BeritaService.getBeritaById(id);
    if (!berita) return;

    const modal = document.getElementById('news-modal');
    const modalImg = document.getElementById('modal-news-img') as HTMLImageElement;
    const modalCat = document.getElementById('modal-news-category');
    const modalDate = document.getElementById('modal-news-date');
    const modalTitle = document.getElementById('modal-news-title');
    const modalExcerpt = document.getElementById('modal-news-excerpt');
    const modalAuthor = document.getElementById('modal-news-author');
    const modalContent = document.getElementById('modal-news-content');

    if (!modal) return;

    if (modalImg) modalImg.src = berita.gambarUrl;
    if (modalCat) modalCat.textContent = berita.kategori;
    if (modalDate) modalDate.textContent = berita.tanggalPublikasi;
    if (modalTitle) modalTitle.textContent = berita.judul;
    if (modalExcerpt) modalExcerpt.textContent = berita.ringkasan;
    if (modalAuthor) modalAuthor.textContent = berita.penulis;

    if (modalContent) {
      // Split paragraphs nicely
      const paragraphs = berita.konten.split(/\n\n+/);
      modalContent.innerHTML = paragraphs
        .map((p) => `<p class="leading-relaxed">${escapeHtml(p)}</p>`)
        .join('');
    }

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeNewsModal() {
    const modal = document.getElementById('news-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  function escapeHtml(str: string): string {
    const p = document.createElement('p');
    p.textContent = str;
    return p.innerHTML;
  }

  function setupNewsInteractions() {
    // 1. Initial render
    renderNewsCards();

    // 2. Category filter buttons
    const filterButtons = document.querySelectorAll('.cat-filter-btn');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white', 'shadow-xs');
          b.classList.add('text-slate-600', 'hover:text-primary', 'hover:bg-slate-100');
        });
        btn.classList.add('bg-primary', 'text-white', 'shadow-xs');
        btn.classList.remove('text-slate-600', 'hover:text-primary', 'hover:bg-slate-100');

        currentCategory = (btn as HTMLElement).dataset.category || 'all';
        renderNewsCards();
      });
    });

    // 3. Search input
    const searchInput = document.getElementById('public-news-search') as HTMLInputElement;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        renderNewsCards();
      });
    }

    // 4. Modal close triggers
    const closeBtn = document.getElementById('modal-news-close-btn');
    const footerCloseBtn = document.getElementById('modal-news-footer-close-btn');
    const modal = document.getElementById('news-modal');

    closeBtn?.addEventListener('click', closeNewsModal);
    footerCloseBtn?.addEventListener('click', closeNewsModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeNewsModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeNewsModal();
    });

    // 5. Listen to cross-component or cross-tab news updates
    window.addEventListener('evote:berita-updated', () => {
      renderNewsCards();
    });
    window.addEventListener('storage', (e) => {
      if (e.key === 'evote_mempawah_berita_v1') {
        renderNewsCards();
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewsInteractions);
  } else {
    setupNewsInteractions();
  }
</script>
