---
import SectionHeader from '../common/SectionHeader.astro';
import StepSvg from '../illustrations/StepSvg.astro';
import { stepsData } from '../../data/content/steps.data';
---

<section id="tahapan" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-slate-200/80">
  <div class="container-custom">
    
    <!-- Section Header -->
    <SectionHeader
      badge="Panduan Memilih"
      title="Alur & Tahapan Pemungutan Suara di TPS"
      subtitle="Panduan langkah demi langkah pemilih dari kedatangan hingga selesai sesuai Panduan Resmi E-Voting 2026"
    />

    <!-- Steps Timeline Layout (Alternating Desktop / Linear Mobile) -->
    <div class="space-y-12 sm:space-y-16 relative">
      
      <!-- Central vertical timeline guide line for desktop -->
      <div class="hidden lg:block absolute left-1/2 top-8 bottom-8 w-1 -ml-0.5 bg-gradient-to-b from-primary via-secondary to-accent opacity-30 rounded-full pointer-events-none"></div>

      {stepsData.map((step, index) => {
        const isEven = index % 2 === 1;
        return (
          <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Step Badge Number for Mobile & Center Marker -->
            <div class="lg:hidden flex items-center gap-3">
              <span class="w-10 h-10 rounded-full bg-primary text-white font-extrabold text-sm flex items-center justify-center shadow-md">
                {step.nomor}
              </span>
              <div>
                <span class="text-xs font-bold text-accent-700 uppercase tracking-wider">{step.kode}</span>
                <h3 class="text-lg font-bold text-slate-900">{step.judul}</h3>
              </div>
            </div>

            <!-- Illustration Column -->
            <div class={`lg:col-span-6 ${isEven ? 'lg:order-2 lg:pl-8' : 'lg:order-1 lg:pr-8'}`}>
              <div class="card-surface p-3 bg-white border-slate-200 shadow-soft hover:shadow-elevated transition-shadow">
                <StepSvg stepNumber={step.nomor} className="h-56 sm:h-64" />
                <div class="p-3 text-center bg-slate-50 rounded-lg mt-2">
                  <span class="text-xs font-semibold text-slate-600 italic">
                    Ilustrasi Alur Operasional TPS — Tahap 0{step.nomor}
                  </span>
                </div>
              </div>
            </div>

            <!-- Content Column -->
            <div class={`lg:col-span-6 ${isEven ? 'lg:order-1 lg:pr-8' : 'lg:order-2 lg:pl-8'}`}>
              <div class="card-surface p-6 sm:p-8 bg-white border-slate-200/90 shadow-soft">
                
                <div class="hidden lg:flex items-center gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-md bg-primary-100 text-primary font-bold text-xs">
                    {step.kode}
                  </span>
                  <span class="text-xs text-slate-400 font-semibold">Langkah 0{step.nomor} dari 06</span>
                </div>

                <h3 class="hidden lg:block text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
                  {step.judul}
                </h3>
                
                <h4 class="text-xs sm:text-sm font-semibold text-primary mt-1 mb-3">
                  {step.subjudul}
                </h4>

                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  {step.deskripsi}
                </p>

                <!-- Key Points Bullet List -->
                <div class="space-y-2 mb-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                  <span class="text-xs font-bold text-slate-700 block mb-1">Poin Penting Pelaksanaan:</span>
                  <ul class="space-y-1.5 text-xs text-slate-600">
                    {step.poinKunci.map((point) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Security Note Footer -->
                {step.catatanKeamanan && (
                  <div class="p-3 rounded-lg bg-blue-50/70 border border-blue-100 flex items-start gap-2 text-xs text-blue-900">
                    <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>
                      <strong class="font-semibold">Jaminan Keamanan:</strong> {step.catatanKeamanan}
                    </span>
                  </div>
                )}

              </div>
            </div>

          </div>
        );
      })}

    </div>

    <!-- 2-Touches Bilik Banner Callout -->
    <div class="mt-14 card-surface p-6 sm:p-8 bg-gradient-to-r from-primary to-primary-800 text-white shadow-elevated">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-2 space-y-2">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-accent text-slate-900 uppercase">
            Kemudahan Memilih
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">
            Cukup 2 Kali Sentuh di Bilik Suara
          </h3>
          <p class="text-xs sm:text-sm text-blue-100 leading-relaxed">
            Tidak perlu mencoblos kertas secara manual. Cukup sentuh foto calon pilihan Anda, lalu sentuh konfirmasi "YA". Jika Anda salah sentuh, cukup tekan tombol silang merah "TIDAK" untuk membatalkan dan mengoreksi pilihan sebelum struk tercetak.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 justify-center">
          <a href="#perangkat" class="btn-accent text-center justify-center text-sm py-3 font-bold">
            Pelajari Perangkat Layar Sentuh &rarr;
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

