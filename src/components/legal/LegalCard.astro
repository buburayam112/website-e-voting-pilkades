---
import { siteConfig } from '../../config/site';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const dasar = siteConfig.dasarHukum;
---

<div class={`card-surface p-6 sm:p-7 flex flex-col justify-between relative overflow-hidden border-slate-200 ${className}`} id="dasar-hukum">
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="inline-flex items-center gap-2">
        <span class="p-2 rounded-lg bg-emerald-50 text-emerald-700">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        </span>
        <h3 class="font-bold text-slate-800 text-base sm:text-lg">Dasar Hukum E-Voting</h3>
      </div>
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
        Rujukan JDIHN
      </span>
    </div>

    <div class="space-y-2">
      <h4 class="text-base font-bold text-primary leading-snug">
        {dasar.judul}
      </h4>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
        {dasar.ringkasan}
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs text-slate-600">
      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
        <span class="font-semibold text-slate-700 block">Pemberlakuan:</span>
        <span>Kabupaten Mempawah</span>
      </div>
      <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
        <span class="font-semibold text-slate-700 block">Status Regulasi:</span>
        <span class="text-emerald-700 font-medium">Perbup 14/2023 (Pasal 46)</span>
      </div>
    </div>
  </div>

  <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
    <span class="text-[11px] text-slate-500">Salinan Dokumen JDIHN</span>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-lg transition-colors"
      onclick="alert('Rujukan yuridis utama pelaksanaan teknis Pilkades e-Voting adalah Perbup Mempawah No. 14 Tahun 2023 (Pasal 2 ayat 1 tentang pelaksanaan dengan e-Voting, Pasal 42 ayat 4, Pasal 46 mengenai mekanisme pemberian suara elektronik, serta Pasal 47 mengenai penghitungan suara) dan Putusan MK No. 147/PUU-VII/2009 (syarat kumulatif Luber Jurdil & kesiapan daerah). Dokumen resmi dapat ditinjau melalui JDIH Kabupaten Mempawah.')"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>Informasi Dokumen</span>
    </button>
  </div>
</div>

