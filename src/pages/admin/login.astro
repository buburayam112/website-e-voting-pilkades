---
import '../../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Administrator — E-Voting Pilkades Mempawah</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-[#0c264d] via-[#103369] to-[#1b51a3] flex items-center justify-center p-4 sm:p-6 text-slate-800 font-sans selection:bg-accent selection:text-slate-900 relative overflow-hidden">
    
    <!-- Background subtle vector lights -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-accent/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-primary-400/20 rounded-full blur-3xl pointer-events-none"></div>

    <main class="w-full max-w-md relative z-10">
      
      <!-- Card Login -->
      <div class="bg-white rounded-3xl shadow-2xl border border-white/20 p-6 sm:p-8 backdrop-blur-md">
        
        <!-- Header / Logo Resmi Pemerintah Kabupaten Mempawah -->
        <div class="text-center mb-7 flex flex-col items-center">
          <div class="w-20 h-20 sm:w-22 sm:h-22 p-2.5 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-soft flex items-center justify-center mb-3.5 transition-transform duration-200 hover:scale-105">
            <img
              src="/images/logo-kabupaten-mempawah.png"
              alt="Lambang Kabupaten Mempawah"
              class="w-full h-full object-contain drop-shadow-xs"
              loading="eager"
            />
          </div>
          <span class="text-[11px] sm:text-xs font-bold tracking-wider text-slate-500 uppercase leading-none mb-1.5">
            Pemerintah Kabupaten Mempawah
          </span>
          <h1 class="text-xl sm:text-2xl font-black tracking-tight text-primary leading-tight">
            E-Voting Pilkades 2026
          </h1>
        </div>

        <!-- Alert Error Message -->
        <div
          id="login-error-alert"
          class="hidden mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-800 text-xs flex items-start gap-2.5 transition-all"
          role="alert"
        >
          <svg class="w-4 h-4 text-red-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="login-error-text">Terjadi kesalahan pada login.</span>
        </div>

        <!-- Form Login -->
        <form id="admin-login-form" class="space-y-4" onsubmit="return false;">
          <!-- Identifier / Username -->
          <div>
            <label for="admin-identifier" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Nama Pengguna / Email
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <input
                type="text"
                id="admin-identifier"
                name="identifier"
                placeholder="admin@mempawahkab.go.id"
                autocomplete="username"
                required
                class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-900 transition-all placeholder:text-slate-400"
              />
            </div>
          </div>

          <!-- Password with toggle -->
          <div>
            <label for="admin-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Kata Sandi
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>
              <input
                type="password"
                id="admin-password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
                class="w-full pl-10 pr-10 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-900 transition-all placeholder:text-slate-400"
              />
              <button
                type="button"
                id="btn-toggle-password"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                title="Tampilkan / Sembunyikan Sandi"
              >
                <!-- Eye open -->
                <svg id="icon-eye-open" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <!-- Eye closed -->
                <svg id="icon-eye-closed" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m15 18-.722-3.25"></path>
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <line x1="2" x2="22" y1="2" y2="22"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Remember me -->
          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                id="admin-remember"
                class="w-4 h-4 text-primary rounded border-slate-300 focus:ring-primary/30"
              />
              <span class="text-xs text-slate-600">Ingat sesi di perangkat ini</span>
            </label>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="btn-submit-login"
            class="w-full btn-primary py-3 rounded-xl text-sm font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 mt-4"
          >
            <span>Masuk ke Dashboard</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
          </button>
        </form>

      </div>

      <!-- Footer back note -->
      <div class="text-center mt-6">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs text-blue-200 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Kembali ke Halaman Informasi Publik</span>
        </a>
      </div>

    </main>

    <!-- Client Script -->
    <script>
      import { AdminAuthService } from '../../services/admin-auth.service';

      // 1. If already authenticated, redirect immediately to dashboard
      AdminAuthService.redirectIfAuthenticated('/admin');

      const form = document.getElementById('admin-login-form') as HTMLFormElement;
      const userInput = document.getElementById('admin-identifier') as HTMLInputElement;
      const passInput = document.getElementById('admin-password') as HTMLInputElement;
      const remInput = document.getElementById('admin-remember') as HTMLInputElement;
      const errorAlert = document.getElementById('login-error-alert');
      const errorText = document.getElementById('login-error-text');
      const submitBtn = document.getElementById('btn-submit-login') as HTMLButtonElement;

      // Password toggle
      const toggleBtn = document.getElementById('btn-toggle-password');
      const eyeOpen = document.getElementById('icon-eye-open');
      const eyeClosed = document.getElementById('icon-eye-closed');

      toggleBtn?.addEventListener('click', () => {
        if (!passInput) return;
        const isPassword = passInput.type === 'password';
        passInput.type = isPassword ? 'text' : 'password';
        eyeOpen?.classList.toggle('hidden', isPassword);
        eyeClosed?.classList.toggle('hidden', !isPassword);
      });

      // Submit Form
      form?.addEventListener('submit', (e) => {
        e.preventDefault();

        const username = userInput.value;
        const password = passInput.value;
        const remember = remInput.checked;

        // Reset error state
        errorAlert?.classList.add('hidden');

        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Memverifikasi...</span>
        `;

        setTimeout(() => {
          const result = AdminAuthService.login(username, password, remember);

          if (result.success) {
            submitBtn.classList.remove('bg-primary');
            submitBtn.classList.add('bg-emerald-600');
            submitBtn.innerHTML = `
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Berhasil Masuk!</span>
            `;
            setTimeout(() => {
              window.location.href = '/admin';
            }, 400);
          } else {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `
              <span>Masuk ke Dashboard</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                <polyline points="10 17 15 12 10 7"></polyline>
                <line x1="15" y1="12" x2="3" y2="12"></line>
              </svg>
            `;
            if (errorText && errorAlert) {
              errorText.textContent = result.message;
              errorAlert.classList.remove('hidden');
            }
          }
        }, 300);
      });
    </script>
  </body>
</html>
