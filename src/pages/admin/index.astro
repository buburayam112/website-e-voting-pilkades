    <!-- ============================================================== -->
    <!-- FLOATING TOAST NOTIFICATION                                    -->
    <!-- ============================================================== -->
    <div
      id="admin-toast"
      class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 max-w-sm p-4 rounded-2xl shadow-xl flex items-center gap-3 border text-xs sm:text-sm"
    >
      <div id="toast-icon"></div>
      <span id="toast-message" class="font-medium"></span>
    </div>

    <!-- CLIENT DASHBOARD SCRIPT -->
    <script>
      import { AdminAuthService } from '../../services/admin-auth.service';
      import { BeritaService } from '../../services/berita.service';
      import type { Berita, KategoriBerita, StatusBerita } from '../../types';

      // 1. ROUTE GUARD: Require authentication
      const isAuthed = AdminAuthService.requireAuth('/admin/login');
      if (!isAuthed) {
        // Will be redirected
      }

      // Display active session username
      const session = AdminAuthService.getSession();
      if (session) {
        const nameEl = document.getElementById('admin-user-name');
        if (nameEl) nameEl.textContent = session.user.name;
      }

      // Handle Logout
      document.getElementById('btn-admin-logout')?.addEventListener('click', () => {
        if (confirm('Apakah Anda yakin ingin keluar dari panel administrator?')) {
          AdminAuthService.logout('/admin/login');
        }
      });

      // Filter states
      let searchFilter = '';
      let categoryFilter = 'all';
      let statusFilter = 'all';
      let deleteTargetId: string | null = null;

      // DOM Elements
      const tableBody = document.getElementById('admin-berita-table-body');
      const emptyState = document.getElementById('table-empty-state');
      const visibleCountEl = document.getElementById('table-visible-count');
      const totalCountEl = document.getElementById('table-total-count');

      // Stat Elements
      const statTotalEl = document.getElementById('stat-total-berita');
      const statPubEl = document.getElementById('stat-published-berita');
      const statDraftEl = document.getElementById('stat-draft-berita');

      // Modals
      const formModal = document.getElementById('modal-form-berita');
      const formTitle = document.getElementById('modal-form-title');
      const crudForm = document.getElementById('berita-crud-form') as HTMLFormElement;
      const previewModal = document.getElementById('modal-preview-berita');
      const deleteModal = document.getElementById('modal-confirm-delete');

      // Form Inputs
      const formIdInput = document.getElementById('form-berita-id') as HTMLInputElement;
      const formJudulInput = document.getElementById('form-judul') as HTMLInputElement;
      const formKategoriInput = document.getElementById('form-kategori') as HTMLSelectElement;
      const formStatusInput = document.getElementById('form-status') as HTMLSelectElement;
      const formTanggalInput = document.getElementById('form-tanggal') as HTMLInputElement;
      const formPenulisInput = document.getElementById('form-penulis') as HTMLInputElement;
      const formGambarInput = document.getElementById('form-gambar-url') as HTMLInputElement;
      const formRingkasanInput = document.getElementById('form-ringkasan') as HTMLTextAreaElement;
      const formKontenInput = document.getElementById('form-konten') as HTMLTextAreaElement;

      // Toast helper
      function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
        const toast = document.getElementById('admin-toast');
        const msg = document.getElementById('toast-message');
        const icon = document.getElementById('toast-icon');
        if (!toast || !msg || !icon) return;

        msg.textContent = message;

        if (type === 'success') {
          toast.className = 'fixed bottom-6 right-6 z-50 transition-all duration-300 max-w-sm p-4 rounded-2xl shadow-xl flex items-center gap-3 border text-xs sm:text-sm bg-emerald-50 border-emerald-200 text-emerald-900 translate-y-0 opacity-100';
          icon.innerHTML = `<svg class="w-5 h-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
        } else if (type === 'error') {
          toast.className = 'fixed bottom-6 right-6 z-50 transition-all duration-300 max-w-sm p-4 rounded-2xl shadow-xl flex items-center gap-3 border text-xs sm:text-sm bg-red-50 border-red-200 text-red-900 translate-y-0 opacity-100';
          icon.innerHTML = `<svg class="w-5 h-5 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
        } else {
          toast.className = 'fixed bottom-6 right-6 z-50 transition-all duration-300 max-w-sm p-4 rounded-2xl shadow-xl flex items-center gap-3 border text-xs sm:text-sm bg-blue-50 border-blue-200 text-blue-900 translate-y-0 opacity-100';
          icon.innerHTML = `<svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        }

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-24', 'opacity-0');
        }, 3500);
      }

      function escapeHtml(str: string): string {
        const p = document.createElement('p');
        p.textContent = str;
        return p.innerHTML;
      }

      // Render Admin Table
      function renderTable() {
        const allItems = BeritaService.getAllRaw();
        const filtered = BeritaService.getBeritaList({
          search: searchFilter,
          kategori: categoryFilter,
          status: statusFilter
        });

        // Update stats
        if (statTotalEl) statTotalEl.textContent = String(allItems.length);
        if (statPubEl) statPubEl.textContent = String(allItems.filter((b) => b.status === 'published').length);
        if (statDraftEl) statDraftEl.textContent = String(allItems.filter((b) => b.status === 'draft').length);

        if (visibleCountEl) visibleCountEl.textContent = String(filtered.length);
        if (totalCountEl) totalCountEl.textContent = String(allItems.length);

        if (!tableBody || !emptyState) return;

        if (filtered.length === 0) {
          tableBody.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');

        tableBody.innerHTML = filtered.map((item, idx) => `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-3 px-4 text-center font-mono text-slate-400 font-semibold">${idx + 1}</td>
            <td class="py-3 px-4">
              <div class="w-16 h-12 rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
                <img
                  src="${escapeHtml(item.gambarUrl)}"
                  alt="${escapeHtml(item.judul)}"
                  class="w-full h-full object-cover"
                  onerror="this.src='/images/logo-kabupaten-mempawah.png'; this.className='w-full h-full object-contain p-1';"
                />
              </div>
            </td>
            <td class="py-3 px-4">
              <h4 class="font-bold text-slate-900 hover:text-primary transition-colors leading-snug line-clamp-1">
                ${escapeHtml(item.judul)}
              </h4>
              <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">${escapeHtml(item.ringkasan)}</p>
              <span class="text-[10px] text-slate-400 font-mono mt-0.5 block truncate max-w-xs">/${escapeHtml(item.slug)}</span>
            </td>
            <td class="py-3 px-4">
              <span class="inline-block px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-primary-50 text-primary border border-primary-100">
                ${escapeHtml(item.kategori)}
              </span>
            </td>
            <td class="py-3 px-4 whitespace-nowrap text-xs text-slate-600 font-mono">
              ${escapeHtml(item.tanggalPublikasi)}
            </td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              ${item.status === 'published'
                ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                     <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Published
                   </span>`
                : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                     <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Draft
                   </span>`
              }
            </td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              <div class="flex items-center justify-center gap-1.5">
                <!-- Preview -->
                <button
                  type="button"
                  class="btn-action-preview p-1.5 rounded-lg text-slate-500 hover:text-primary hover:bg-primary-50 transition-colors"
                  data-id="${escapeHtml(item.id)}"
                  title="Lihat Pratinjau"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
                <!-- Edit -->
                <button
                  type="button"
                  class="btn-action-edit p-1.5 rounded-lg text-slate-500 hover:text-amber-600 hover:bg-amber-50 transition-colors"
                  data-id="${escapeHtml(item.id)}"
                  title="Edit Berita"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                  </svg>
                </button>
                <!-- Delete -->
                <button
                  type="button"
                  class="btn-action-delete p-1.5 rounded-lg text-slate-500 hover:text-red-600 hover:bg-red-50 transition-colors"
                  data-id="${escapeHtml(item.id)}"
                  title="Hapus Berita"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `).join('');

        // Attach action listeners
        tableBody.querySelectorAll('.btn-action-preview').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = (btn as HTMLElement).dataset.id;
            if (id) openPreview(id);
          });
        });

        tableBody.querySelectorAll('.btn-action-edit').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = (btn as HTMLElement).dataset.id;
            if (id) openEditModal(id);
          });
        });

        tableBody.querySelectorAll('.btn-action-delete').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = (btn as HTMLElement).dataset.id;
            if (id) openDeleteModal(id);
          });
        });
      }

      // Image Management Elements
      const tabBtnUpload = document.getElementById('tab-btn-upload');
      const tabBtnPresets = document.getElementById('tab-btn-presets');
      const tabBtnUrl = document.getElementById('tab-btn-url');
      const panelUpload = document.getElementById('panel-image-upload');
      const panelPresets = document.getElementById('panel-image-presets');
      const panelUrl = document.getElementById('panel-image-url');
      const fileUploadInput = document.getElementById('form-file-upload') as HTMLInputElement;
      const dropzoneBox = document.getElementById('dropzone-box');
      const selectedImgPreview = document.getElementById('selected-img-preview') as HTMLImageElement;
      const selectedImgName = document.getElementById('selected-img-name');
      const selectedImgBadge = document.getElementById('selected-img-badge');
      const btnTriggerUploadReplace = document.getElementById('btn-trigger-upload-replace');
      const formGambarUrlManual = document.getElementById('form-gambar-url-manual') as HTMLInputElement;

      // Switch Image Tab
      function switchImageTab(tab: 'upload' | 'presets' | 'url') {
        const tabs = [
          { name: 'upload', btn: tabBtnUpload, panel: panelUpload },
          { name: 'presets', btn: tabBtnPresets, panel: panelPresets },
          { name: 'url', btn: tabBtnUrl, panel: panelUrl }
        ];

        tabs.forEach((t) => {
          if (t.name === tab) {
            t.btn?.classList.add('bg-white', 'text-primary', 'shadow-xs', 'font-bold');
            t.btn?.classList.remove('hover:text-slate-900');
            t.panel?.classList.remove('hidden');
          } else {
            t.btn?.classList.remove('bg-white', 'text-primary', 'shadow-xs', 'font-bold');
            t.btn?.classList.add('hover:text-slate-900');
            t.panel?.classList.add('hidden');
          }
        });
      }

      tabBtnUpload?.addEventListener('click', () => switchImageTab('upload'));
      tabBtnPresets?.addEventListener('click', () => switchImageTab('presets'));
      tabBtnUrl?.addEventListener('click', () => switchImageTab('url'));

      // Update Preview Card Helper
      function updateImagePreview(url: string, name: string, badgeText: string = 'Foto Terpilih') {
        if (formGambarInput) formGambarInput.value = url;
        if (selectedImgPreview) selectedImgPreview.src = url;
        if (selectedImgName) selectedImgName.textContent = name;
        if (selectedImgBadge) selectedImgBadge.textContent = badgeText;
      }

      // Process and compress image file from device
      function handleDeviceImageFile(file: File) {
        if (!file.type.startsWith('image/')) {
          showToast('File yang dipilih harus berupa gambar (PNG, JPG, WEBP).', 'error');
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
          const rawUrl = e.target?.result as string;
          const img = new Image();
          img.onload = () => {
            const maxDim = 1200;
            let width = img.width;
            let height = img.height;

            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(img, 0, 0, width, height);
              const compressed = canvas.toDataURL('image/jpeg', 0.82);
              updateImagePreview(compressed, file.name, 'Foto dari Perangkat');
            } else {
              updateImagePreview(rawUrl, file.name, 'Foto dari Perangkat');
            }
            showToast('Foto dari perangkat berhasil dimuat!', 'success');
          };
          img.src = rawUrl;
        };
        reader.readAsDataURL(file);
      }

      // File input triggers
      dropzoneBox?.addEventListener('click', () => fileUploadInput?.click());
      btnTriggerUploadReplace?.addEventListener('click', () => fileUploadInput?.click());

      fileUploadInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) handleDeviceImageFile(file);
      });

      // Dropzone drag-and-drop
      dropzoneBox?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzoneBox?.classList.add('border-primary', 'bg-blue-50/80');
      });

      dropzoneBox?.addEventListener('dragleave', () => {
        dropzoneBox?.classList.remove('border-primary', 'bg-blue-50/80');
      });

      dropzoneBox?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzoneBox?.classList.remove('border-primary', 'bg-blue-50/80');
        const file = e.dataTransfer?.files?.[0];
        if (file) handleDeviceImageFile(file);
      });

      // Manual URL input change
      formGambarUrlManual?.addEventListener('input', (e) => {
        const url = (e.target as HTMLInputElement).value.trim();
        if (url) {
          updateImagePreview(url, 'Tautan URL Kustom', 'URL Eksternal');
        }
      });

      // Open Modal Create
      function openCreateModal() {
        if (!formModal || !crudForm) return;
        crudForm.reset();
        formIdInput.value = '';
        if (formTitle) formTitle.textContent = 'Tambah Berita Baru';
        formTanggalInput.value = new Date().toISOString().split('T')[0];
        formPenulisInput.value = 'Tim Humas Diskominfo Kab. Mempawah';
        formStatusInput.value = 'published';

        // Reset image selector
        switchImageTab('upload');
        updateImagePreview('/images/tahapan/revised/tahap-3.png', 'tahap-3.png (Bawaan)', 'Foto Standar');

        formModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      // Open Modal Edit
      function openEditModal(id: string) {
        const item = BeritaService.getBeritaById(id);
        if (!item || !formModal) return;

        formIdInput.value = item.id;
        if (formTitle) formTitle.textContent = 'Edit Berita E-Voting';
        formJudulInput.value = item.judul;
        formKategoriInput.value = item.kategori;
        formStatusInput.value = item.status;
        formTanggalInput.value = item.tanggalPublikasi;
        formPenulisInput.value = item.penulis;
        formRingkasanInput.value = item.ringkasan;
        formKontenInput.value = item.konten;

        // Set existing image in preview
        const isDataUrl = item.gambarUrl.startsWith('data:image/');
        const imgName = isDataUrl ? 'Foto Diunggah Sebelumnya' : (item.gambarUrl.split('/').pop() || 'Gambar Berita');
        const badge = isDataUrl ? 'Foto dari Perangkat' : 'Galeri Resmi';
        updateImagePreview(item.gambarUrl, imgName, badge);

        if (isDataUrl) {
          switchImageTab('upload');
        } else if (item.gambarUrl.startsWith('http')) {
          switchImageTab('url');
          if (formGambarUrlManual) formGambarUrlManual.value = item.gambarUrl;
        } else {
          switchImageTab('presets');
        }

        formModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      // Close Form Modal
      function closeFormModal() {
        if (formModal) {
          formModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      // Open Preview Modal
      function openPreview(id: string) {
        const item = BeritaService.getBeritaById(id);
        if (!item || !previewModal) return;

        const img = document.getElementById('preview-img') as HTMLImageElement;
        const cat = document.getElementById('preview-category');
        const date = document.getElementById('preview-date');
        const title = document.getElementById('preview-title');
        const excerpt = document.getElementById('preview-excerpt');
        const author = document.getElementById('preview-author');
        const statusBadge = document.getElementById('preview-status-badge');
        const content = document.getElementById('preview-content');

        if (img) img.src = item.gambarUrl;
        if (cat) cat.textContent = item.kategori;
        if (date) date.textContent = item.tanggalPublikasi;
        if (title) title.textContent = item.judul;
        if (excerpt) excerpt.textContent = item.ringkasan;
        if (author) author.textContent = item.penulis;

        if (statusBadge) {
          statusBadge.textContent = item.status === 'published' ? 'Live di Web Publik' : 'Draft Internal';
          statusBadge.className = item.status === 'published' ? 'px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-emerald-100 text-emerald-800' : 'px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-amber-100 text-amber-800';
        }

        if (content) {
          const paragraphs = item.konten.split(/\n\n+/);
          content.innerHTML = paragraphs.map(p => `<p>${escapeHtml(p)}</p>`).join('');
        }

        previewModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closePreviewModal() {
        if (previewModal) {
          previewModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      // Delete Modal
      function openDeleteModal(id: string) {
        const item = BeritaService.getBeritaById(id);
        if (!item || !deleteModal) return;

        deleteTargetId = id;
        const titleEl = document.getElementById('delete-news-title');
        if (titleEl) titleEl.textContent = `"${item.judul}"`;

        deleteModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeDeleteModal() {
        if (deleteModal) {
          deleteModal.classList.add('hidden');
          deleteTargetId = null;
          document.body.style.overflow = '';
        }
      }

      // Event Listeners for UI
      document.getElementById('btn-open-create-modal')?.addEventListener('click', openCreateModal);
      document.getElementById('btn-close-form-modal')?.addEventListener('click', closeFormModal);
      document.getElementById('btn-cancel-form')?.addEventListener('click', closeFormModal);

      document.getElementById('btn-close-preview')?.addEventListener('click', closePreviewModal);
      document.getElementById('btn-close-preview-footer')?.addEventListener('click', closePreviewModal);

      document.getElementById('btn-cancel-delete')?.addEventListener('click', closeDeleteModal);

      // Confirm Delete
      document.getElementById('btn-confirm-delete')?.addEventListener('click', () => {
        if (!deleteTargetId) return;
        const success = BeritaService.deleteBerita(deleteTargetId);
        closeDeleteModal();
        if (success) {
          showToast('Berita berhasil dihapus!', 'success');
          renderTable();
        } else {
          showToast('Gagal menghapus berita.', 'error');
        }
      });

      // Preset Image Buttons
      document.querySelectorAll('.preset-img-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.preset-img-btn').forEach(b => {
            b.classList.remove('border-primary', 'border-2');
            b.classList.add('border-slate-200', 'border');
          });
          btn.classList.add('border-primary', 'border-2');
          btn.classList.remove('border-slate-200');

          const imgUrl = (btn as HTMLElement).dataset.img;
          if (imgUrl && formGambarInput) {
            formGambarInput.value = imgUrl;
          }
        });
      });

      // Handle Form Submit (Create / Edit)
      crudForm?.addEventListener('submit', (e) => {
        e.preventDefault();

        const id = formIdInput.value;
        const judul = formJudulInput.value.trim();
        const kategori = formKategoriInput.value as KategoriBerita;
        const status = formStatusInput.value as StatusBerita;
        const tanggalPublikasi = formTanggalInput.value;
        const penulis = formPenulisInput.value.trim();
        const gambarUrl = formGambarInput.value.trim();
        const ringkasan = formRingkasanInput.value.trim();
        const konten = formKontenInput.value.trim();

        if (!judul || !ringkasan || !konten) {
          showToast('Mohon lengkapi field yang bertanda bintang (*).', 'error');
          return;
        }

        if (id) {
          // UPDATE
          const updated = BeritaService.updateBerita(id, {
            judul,
            kategori,
            status,
            tanggalPublikasi,
            penulis,
            gambarUrl,
            ringkasan,
            konten
          });
          if (updated) {
            showToast('Berita berhasil diperbarui!', 'success');
            closeFormModal();
            renderTable();
          } else {
            showToast('Gagal memperbarui berita.', 'error');
          }
        } else {
          // CREATE
          const created = BeritaService.createBerita({
            judul,
            kategori,
            status,
            tanggalPublikasi,
            penulis,
            gambarUrl,
            ringkasan,
            konten
          });
          if (created) {
            showToast('Berita baru berhasil ditambahkan dan disimpan!', 'success');
            closeFormModal();
            renderTable();
          } else {
            showToast('Gagal menambahkan berita.', 'error');
          }
        }
      });

      // Filter events
      document.getElementById('admin-filter-search')?.addEventListener('input', (e) => {
        searchFilter = (e.target as HTMLInputElement).value;
        renderTable();
      });

      document.getElementById('admin-filter-category')?.addEventListener('change', (e) => {
        categoryFilter = (e.target as HTMLSelectElement).value;
        renderTable();
      });

      document.getElementById('admin-filter-status')?.addEventListener('change', (e) => {
        statusFilter = (e.target as HTMLSelectElement).value;
        renderTable();
      });

      // Reset Demo Data
      document.getElementById('btn-reset-data')?.addEventListener('click', () => {
        if (confirm('Kembalikan seluruh daftar berita ke data default awal?')) {
          BeritaService.resetDefaultBerita();
          showToast('Data berita berhasil direset ke data default.', 'info');
          renderTable();
        }
      });

      // Initial Table Render
      renderTable();
    </script>
  </body>
</html>
