---
import '../../styles/global.css';
import KominfoLogo from '../../components/common/KominfoLogo.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin E-Voting — Kelola Berita & Informasi Publik</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 font-sans selection:bg-accent selection:text-slate-900 pb-20">
    
    <!-- TOP ADMIN NAVBAR -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo & Brand Badge -->
          <div class="flex items-center gap-4">
            <div class="inline-flex items-center p-1.5 rounded-xl bg-slate-50 border border-slate-200/80 shadow-xs">
              <KominfoLogo />
            </div>
            <div class="hidden sm:block">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-primary-50 text-primary border border-primary-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Panel Administrator
              </span>
              <h1 class="text-sm font-bold text-slate-900">
                Pengelolaan Berita & Sosialisasi E-Voting
              </h1>
            </div>
          </div>

          <!-- User Controls & Action Buttons -->
          <div class="flex items-center gap-3">
            <a
              href="/"
              target="_blank"
              class="hidden md:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 hover:text-slate-900 transition-colors"
              title="Buka Website Publik Warga di Tab Baru"
            >
              <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>Lihat Portal Warga</span>
            </a>

            <!-- Admin Profile Card -->
            <div class="flex items-center gap-2 pl-2 sm:pl-4 border-l border-slate-200">
              <div class="w-9 h-9 rounded-full bg-primary-100 text-primary flex items-center justify-center font-bold text-xs shadow-inner">
                AD
              </div>
              <div class="hidden lg:block text-left">
                <span id="admin-user-name" class="block text-xs font-bold text-slate-800 leading-tight">Admin Diskominfo</span>
                <span class="block text-[10px] text-emerald-600 font-semibold">Aktif • Sesi Aman</span>
              </div>
            </div>

            <!-- Logout Button -->
            <button
              type="button"
              id="btn-admin-logout"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition-colors ml-1"
              title="Keluar dari Panel Admin"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span class="hidden sm:inline">Keluar</span>
            </button>
          </div>

        </div>
      </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      
      <!-- PAGE HEADER & ACTION CTA -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Dashboard Manajemen Berita
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Kelola publikasi informasi, artikel teknis TPS, sosialisasi, dan regulasi Pilkades 2026.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="btn-open-create-modal"
            class="btn-primary text-xs sm:text-sm py-2.5 px-4 rounded-xl shadow-md flex items-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Tambah Berita Baru</span>
          </button>

          <button
            type="button"
            id="btn-reset-data"
            class="p-2.5 rounded-xl border border-slate-300 text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
            title="Reset ke Data Default Demo"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
              <path d="M21 3v5h-5"></path>
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
              <path d="M8 16H3v5"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- STATS OVERVIEW CARDS -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
        
        <!-- Total Berita -->
        <div class="card-surface p-5 border-slate-200/90 flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-primary flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
              <path d="M18 14h-8"></path>
              <path d="M15 18h-5"></path>
              <path d="M10 6h8v4h-8V6Z"></path>
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Berita</span>
            <span id="stat-total-berita" class="text-2xl font-extrabold text-slate-900">0</span>
          </div>
        </div>

        <!-- Berita Terbit (Published) -->
        <div class="card-surface p-5 border-slate-200/90 flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Terbit (Live)</span>
            <span id="stat-published-berita" class="text-2xl font-extrabold text-emerald-600">0</span>
          </div>
        </div>

        <!-- Draf (Draft) -->
        <div class="card-surface p-5 border-slate-200/90 flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Draf (Tersimpan)</span>
            <span id="stat-draft-berita" class="text-2xl font-extrabold text-amber-600">0</span>
          </div>
        </div>

        <!-- Kategori Aktif -->
        <div class="card-surface p-5 border-slate-200/90 flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Kategori Aktif</span>
            <span id="stat-categories" class="text-2xl font-extrabold text-slate-900">5</span>
          </div>
        </div>

      </div>

      <!-- SEARCH, FILTER, AND TABLE CARD -->
      <div class="card-surface border-slate-200/90 overflow-hidden shadow-elevated">
        
        <!-- Filter Toolbar -->
        <div class="p-4 sm:p-6 border-b border-slate-200/80 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
          
          <!-- Search Box -->
          <div class="relative w-full sm:w-80">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </div>
            <input
              type="text"
              id="admin-filter-search"
              placeholder="Cari judul atau topik..."
              class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm rounded-xl border border-slate-300 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 transition-all"
            />
          </div>

          <!-- Filters: Kategori & Status -->
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <!-- Filter Kategori -->
            <select
              id="admin-filter-category"
              class="text-xs sm:text-sm py-2 px-3 rounded-xl border border-slate-300 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-700"
            >
              <option value="all">Semua Kategori</option>
              <option value="Sosialisasi">Sosialisasi</option>
              <option value="Teknis & Peralatan">Teknis & Peralatan</option>
              <option value="Regulasi">Regulasi</option>
              <option value="Jadwal & Tahapan">Jadwal & Tahapan</option>
              <option value="Pengumuman">Pengumuman</option>
            </select>

            <!-- Filter Status -->
            <select
              id="admin-filter-status"
              class="text-xs sm:text-sm py-2 px-3 rounded-xl border border-slate-300 bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-700"
            >
              <option value="all">Semua Status</option>
              <option value="published">Published (Terbit)</option>
              <option value="draft">Draft (Draf)</option>
            </select>
          </div>

        </div>

        <!-- Table Container -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm text-slate-700">
            <thead class="bg-slate-100/80 text-[11px] font-bold text-slate-600 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th scope="col" class="py-3.5 px-4 w-12 text-center">No</th>
                <th scope="col" class="py-3.5 px-4 w-24">Thumbnail</th>
                <th scope="col" class="py-3.5 px-4">Judul & Ringkasan</th>
                <th scope="col" class="py-3.5 px-4 w-36">Kategori</th>
                <th scope="col" class="py-3.5 px-4 w-32">Tanggal Rilis</th>
                <th scope="col" class="py-3.5 px-4 w-28 text-center">Status</th>
                <th scope="col" class="py-3.5 px-4 w-36 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody id="admin-berita-table-body" class="divide-y divide-slate-200/70">
              <!-- Dynamically rendered via client script -->
            </tbody>
          </table>
        </div>

        <!-- Table Empty State -->
        <div id="table-empty-state" class="hidden py-16 text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </div>
          <p class="text-sm font-bold text-slate-700">Belum ada berita yang sesuai</p>
          <p class="text-xs text-slate-500 mt-0.5">Silakan tambahkan berita baru atau ubah filter pencarian.</p>
        </div>

        <!-- Table Footer / Count -->
        <div class="p-4 border-t border-slate-200/80 bg-slate-50/50 flex items-center justify-between text-xs text-slate-500">
          <div>
            Menampilkan <span id="table-visible-count" class="font-bold text-slate-800">0</span> dari <span id="table-total-count" class="font-bold text-slate-800">0</span> berita
          </div>
          <span class="text-emerald-700 font-medium">Tersimpan secara lokal & otomatis diperbarui ke portal warga</span>
        </div>

      </div>

    </main>

    <!-- ============================================================== -->
    <!-- MODAL FORM: TAMBAH & EDIT BERITA                               -->
    <!-- ============================================================== -->
    <div
      id="modal-form-berita"
      class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-sm p-4 sm:p-6 flex items-center justify-center"
      role="dialog"
      aria-modal="true"
    >
      <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden max-h-[92vh] flex flex-col">
        
        <!-- Modal Form Header -->
        <div class="p-5 sm:p-6 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-blue-50/60 to-white">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-100 text-primary flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
              </svg>
            </div>
            <div>
              <h3 id="modal-form-title" class="text-base sm:text-lg font-bold text-slate-900">
                Tambah Berita Baru
              </h3>
              <p class="text-xs text-slate-500">
                Isi form berikut untuk mempublikasikan informasi Pilkades
              </p>
            </div>
          </div>
          <button
            type="button"
            id="btn-close-form-modal"
            class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Form Body -->
        <form id="berita-crud-form" class="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs sm:text-sm">
          <input type="hidden" id="form-berita-id" value="" />

          <!-- Judul Berita -->
          <div>
            <label for="form-judul" class="block font-bold text-slate-700 mb-1">
              Judul Berita <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="form-judul"
              placeholder="Contoh: Diskominfo Gelar Simulasi E-Voting di Desa Antibar"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-900 font-semibold"
            />
          </div>

          <!-- Kategori & Status (2 Kolom) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-kategori" class="block font-bold text-slate-700 mb-1">
                Kategori Berita <span class="text-red-500">*</span>
              </label>
              <select
                id="form-kategori"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 bg-white"
              >
                <option value="Sosialisasi">Sosialisasi</option>
                <option value="Teknis & Peralatan">Teknis & Peralatan</option>
                <option value="Regulasi">Regulasi</option>
                <option value="Jadwal & Tahapan">Jadwal & Tahapan</option>
                <option value="Pengumuman">Pengumuman</option>
              </select>
            </div>

            <div>
              <label for="form-status" class="block font-bold text-slate-700 mb-1">
                Status Publikasi <span class="text-red-500">*</span>
              </label>
              <select
                id="form-status"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 bg-white"
              >
                <option value="published">Published (Ditayangkan untuk Warga)</option>
                <option value="draft">Draft (Draf Disimpan di Admin Saja)</option>
              </select>
            </div>
          </div>

          <!-- Tanggal & Penulis (2 Kolom) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-tanggal" class="block font-bold text-slate-700 mb-1">
                Tanggal Publikasi
              </label>
              <input
                type="date"
                id="form-tanggal"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800 bg-white"
              />
            </div>

            <div>
              <label for="form-penulis" class="block font-bold text-slate-700 mb-1">
                Penulis / Instansi
              </label>
              <input
                type="text"
                id="form-penulis"
                placeholder="Humas Diskominfo Mempawah"
                value="Humas Diskominfo Mempawah"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary/20 text-slate-800"
              />
            </div>
          </div>

          <!-- Pilihan Sumber Foto / Gambar Thumbnail -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <label class="block font-bold text-slate-700">
                Foto / Gambar Thumbnail Berita <span class="text-red-500">*</span>
              </label>
              <!-- Image Mode Tabs -->
              <div class="flex items-center gap-1 p-0.5 bg-slate-100 rounded-lg text-[11px] font-semibold text-slate-600">
                <button
                  type="button"
                  id="tab-btn-upload"
                  class="px-2.5 py-1 rounded-md bg-white text-primary shadow-xs font-bold transition-all"
                >
                  Unggah dari Perangkat
                </button>
                <button
                  type="button"
                  id="tab-btn-presets"
                  class="px-2.5 py-1 rounded-md hover:text-slate-900 transition-all"
                >
                  Pilih Galeri
                </button>
                <button
                  type="button"
                  id="tab-btn-url"
                  class="px-2.5 py-1 rounded-md hover:text-slate-900 transition-all"
                >
                  Tautan URL
                </button>
              </div>
            </div>

            <!-- Panel 1: Unggah Foto dari Perangkat (Dropzone & File Picker) -->
            <div id="panel-image-upload" class="space-y-2">
              <input
                type="file"
                id="form-file-upload"
                accept="image/png, image/jpeg, image/jpg, image/webp"
                class="hidden"
              />
              <div
                id="dropzone-box"
                class="border-2 border-dashed border-slate-300 hover:border-primary rounded-2xl p-5 text-center cursor-pointer bg-slate-50/70 hover:bg-blue-50/40 transition-all group flex flex-col items-center justify-center"
              >
                <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center mb-2 group-hover:scale-110 transition-transform shadow-xs">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                </div>
                <p class="text-xs sm:text-sm font-bold text-slate-800">
                  Klik untuk memilih foto dari laptop/HP, atau seret file ke sini
                </p>
                <p class="text-[11px] text-slate-500 mt-0.5">
                  Mendukung file PNG, JPG, JPEG, WEBP (Otomatis dioptimalkan)
                </p>
              </div>
            </div>

            <!-- Panel 2: Galeri Resmi Bawaan -->
            <div id="panel-image-presets" class="hidden space-y-2">
              <p class="text-[11px] text-slate-500 font-medium">Klik salah satu gambar ilustrasi resmi di bawah:</p>
              <div class="grid grid-cols-3 sm:grid-cols-5 gap-2" id="preset-image-selector">
                <button
                  type="button"
                  class="preset-img-btn border-2 border-primary rounded-xl overflow-hidden h-14 bg-slate-100 hover:opacity-90 relative transition-all"
                  data-img="/images/tahapan/revised/tahap-3.png"
                  title="Bilik Suara & Layar Sentuh"
                >
                  <img src="/images/tahapan/revised/tahap-3.png" alt="Tahap 3" class="w-full h-full object-cover" />
                </button>
                <button
                  type="button"
                  class="preset-img-btn border border-slate-200 rounded-xl overflow-hidden h-14 bg-slate-100 hover:opacity-90 relative transition-all"
                  data-img="/images/perangkat/layar-sentuh-e-voting.png"
                  title="Layar Sentuh Kiosk"
                >
                  <img src="/images/perangkat/layar-sentuh-e-voting.png" alt="Layar Sentuh" class="w-full h-full object-cover" />
                </button>
                <button
                  type="button"
                  class="preset-img-btn border border-slate-200 rounded-xl overflow-hidden h-14 bg-slate-100 hover:opacity-90 relative transition-all"
                  data-img="/images/tahapan/revised/tahap-4.png"
                  title="Struk Audit VVPAT"
                >
