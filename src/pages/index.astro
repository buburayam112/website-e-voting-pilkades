---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import AboutSection from '../components/about/AboutSection.astro';
import EquipmentSection from '../components/equipment/EquipmentSection.astro';
import VotingStepsSection from '../components/voting-steps/VotingStepsSection.astro';
import VoterSearchSection from '../components/voter-search/VoterSearchSection.astro';
import SecuritySection from '../components/security/SecuritySection.astro';
import NewsSection from '../components/news/NewsSection.astro';
import CandidateSection from '../components/candidates/CandidateSection.astro';
import StatisticsSection from '../components/statistics/StatisticsSection.astro';
---

<MainLayout>
  <!-- SECTION 2 — HERO -->
  <HeroSection />

  <!-- SECTION 3, 4, 5 — PENGENALAN E-VOTING, COUNTDOWN, CEK HAK PILIH & DASAR HUKUM -->
  <AboutSection />

  <!-- SECTION 6 — PERANGKAT E-VOTING -->
  <EquipmentSection />

  <!-- SECTION 7 — TAHAPAN PEMUNGUTAN SUARA -->
  <VotingStepsSection />

  <!-- SECTION 8 — CEK HAK PILIH DAN INFORMASI TPS -->
  <VoterSearchSection />

  <!-- SECTION 9 — KEAMANAN DAN TRANSPARANSI -->
  <SecuritySection />

  <!-- SECTION 10 — PUSAT INFORMASI & BERITA RESMI -->
  <NewsSection />

  <!-- SECTION 11 — INFORMASI CALON KEPALA DESA -->
  <CandidateSection />

  <!-- SECTION 12 — DASHBOARD STATISTIK -->
  <StatisticsSection />
</MainLayout>

